# DeepSeek API Key（必填，从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI 兼容 Base URL（可选，默认 https://api.deepseek.com）
OPENAI_BASE_URL=https://api.deepseek.com

# Tavily 搜索 API Key（可选）
TAVILY_API_KEY=

# 嵌入模型（fastembed = 免费本地 ONNX，无需 API key）
EMBEDDING_PROVIDER=fastembed

# TTS 配置
TTS_PROVIDER=edge
VOICE_NAME=zh-CN-XiaoxiaoNeural
SPEAKING_RATE=1.0
PITCH=0.0
VOLUME=1.0

# ============================================================
# 第三方登录（QQ 互联 / 微信开放平台「网站应用」）
# ============================================================
# ⚠️ 密钥类配置刻意不进 system_config 的管理页面，只走环境变量。
#
# OAUTH_MODE:
#   live = 接真实接口（**默认，安全**），只有配齐 AppID/Secret 的 provider 才会启用
#   mock = 本地联调，不访问外网，用确定性假身份跑通整条链路
# ⚠️ mock 会让任何人用假身份直接登录，**生产环境绝对不能开**。
#    部署时请确认这里是 live（后端启动时也会打 SECURITY 警告，/health 里也可见）。
OAUTH_MODE=live
#
# 前端地址：回调成功后 302 回 {FRONTEND_BASE_URL}/#/oauth/callback
FRONTEND_BASE_URL=http://127.0.0.1:5173
#
# 后端对外地址：拼接成 {OAUTH_CALLBACK_BASE}/auth/oauth/{provider}/callback
# ⚠️ 这个地址必须与开放平台注册的回调地址【完全一致】（域名 + path），否则 QQ 报 100010
# ⚠️ QQ 明确规定回调地址不能用 localhost / IP / 端口，且不能带 #
#    所以本地 mock 用 127.0.0.1 没问题，接真接口必须换成公网域名
OAUTH_CALLBACK_BASE=http://127.0.0.1:8000
#
# 也可以按 provider 单独指定回调（优先级更高）
# QQ_REDIRECT_URI=https://your-domain.com/auth/oauth/qq/callback
# WECHAT_REDIRECT_URI=https://your-domain.com/auth/oauth/wechat/callback
#
# QQ 互联：https://connect.qq.com/ 创建「网站应用」后取得
QQ_APP_ID=
QQ_APP_KEY=
#
# 微信开放平台：https://open.weixin.qq.com/ 创建「网站应用」后取得
# ⚠️ 不是公众号、不是小程序；需开发者资质认证（约 300 元/年）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
#
# 第三方新用户的初始状态：approved=扫码即用（默认）；pending=沿用管理员审批流
OAUTH_DEFAULT_STATUS=approved
#
# mock 模式下使用的假身份（同一个值重复登录会复用同一个账号）
OAUTH_MOCK_SUBJECT=local_tester

# --- 以下为 Docker 构建时变量 ---
# VITE_API_BASE：前端 API 地址。Docker 部署用 /api（nginx 反向代理）。本地开发用 http://127.0.0.1:8000
VITE_API_BASE=/api
# VITE_WS_BASE：WebSocket 地址。留空 = 从浏览器 location 自动推导（推荐）
VITE_WS_BASE=
